{
	"version": "2.0.0",
	"tasks": [
		{
			"type": "shell",
			"label": "CMake: Configure Debug",
			"command": "cmake",
			"args": [
				"--preset",
				"Debug"
			],
			"options": {
				"cwd": "${workspaceFolder}/OpenSX70_ECM"
			},
			"problemMatcher": [],
			"detail": "Configure CMake project"
		},
		{
			"type": "shell",
			"label": "CMake: Build Debug",
			"command": "cmake",
			"args": [
				"--build",
				"--preset",
				"Debug"
			],
			"options": {
				"cwd": "${workspaceFolder}/OpenSX70_ECM"
			},
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"problemMatcher": [
				"$gcc"
			],
			"detail": "Build the CMake project",
			"dependsOn": [
				"CMake: Configure Debug"
			]
		},
		{
			"type": "shell",
			"label": "CMake: Configure Release",
			"command": "cmake",
			"args": [
				"--preset",
				"Release"
			],
			"options": {
				"cwd": "${workspaceFolder}/OpenSX70_ECM"
			},
			"problemMatcher": [],
			"detail": "Configure CMake project for Release"
		},
		{
			"type": "shell",
			"label": "CMake: Build Release",
			"command": "cmake",
			"args": [
				"--build",
				"--preset",
				"Release"
			],
			"options": {
				"cwd": "${workspaceFolder}/OpenSX70_ECM"
			},
			"group": "build",
			"problemMatcher": [
				"$gcc"
			],
			"detail": "Build the CMake project in Release mode",
			"dependsOn": [
				"CMake: Configure Release"
			]
		},
		{
			"type": "shell",
			"label": "CMake: Configure Bootloader Release",
			"command": "cmake",
			"args": [
				"--preset",
				"BootloaderRelease"
			],
			"options": {
				"cwd": "${workspaceFolder}/OpenSX70_ECM"
			},
			"problemMatcher": [],
			"detail": "Configure CMake project for Bootloader Release"
		},
		{
			"type": "shell",
			"label": "CMake: Build Bootloader Release",
			"command": "cmake",
			"args": [
				"--build",
				"--preset",
				"BootloaderRelease"
			],
			"options": {
				"cwd": "${workspaceFolder}/OpenSX70_ECM"
			},
			"group": "build",
			"problemMatcher": [
				"$gcc"
			],
			"detail": "Build the CMake project in Bootloader Release mode",
			"dependsOn": [
				"CMake: Configure Bootloader Release"
			]
		},
		{
			"type": "shell",
			"label": "CMake: Clean",
			"command": "cmake",
			"args": [
				"-E",
				"rm",
				"-rf",
				"${workspaceFolder}/OpenSX70_ECM/build"
			],
			"problemMatcher": [],
			"detail": "Clean build directory"
		}
	]
}